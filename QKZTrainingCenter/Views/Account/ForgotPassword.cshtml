
@model QKZTrainingCenter.Models.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
}

<section class="login-page">

    <div class="login-header">
        <p class="section-label">QKZ TRAINING CENTER</p>
        <h1>Forgot Password?</h1>
        <p>Enter your registered email address to request a password reset.</p>
    </div>

    <div class="login-form-card">

        <form asp-controller="Account"
              asp-action="ForgotPassword"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>

            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email"
                       class="form-control"
                       type="email"
                       autocomplete="email" />
                <span asp-validation-for="Email"
                      class="text-danger">
                </span>
            </div>

            <button type="submit" class="btn login-submit-btn">
                Request Password Reset
            </button>

        </form>

        <div class="login-register-link">
            <a asp-controller="Account" asp-action="Login">
                Back to Login
            </a>
        </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
