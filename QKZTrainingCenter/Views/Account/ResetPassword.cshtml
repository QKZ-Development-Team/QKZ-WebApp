@model QKZTrainingCenter.Models.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
}

<section class="login-page">

    <div class="login-header">
        <p class="section-label">QKZ TRAINING CENTER</p>
        <h1>Reset Your Password</h1>
        <p>Choose a new password for your account.</p>
    </div>

    <div class="login-form-card">

        <form asp-controller="Account"
              asp-action="ResetPassword"
              method="post">

            @Html.AntiForgeryToken()

            <input asp-for="Token" type="hidden" />

            <input asp-for="Email" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>

            <div class="form-group">
                <label asp-for="NewPassword"></label>
                <input asp-for="NewPassword"
                       class="form-control"
                       autocomplete="new-password"
                       placeholder="At least 8 characters" />
                <span asp-validation-for="NewPassword"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword"
                       class="form-control"
                       autocomplete="new-password"
                       placeholder="Enter your new password again" />
                <span asp-validation-for="ConfirmPassword"
                      class="text-danger">
                </span>
            </div>

            <button type="submit" class="btn login-submit-btn">
                Reset Password
            </button>

        </form>

        <div class="login-register-link">
            <a asp-controller="Account" asp-action="Login">
                Back to Login
            </a>
        </div>

    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}