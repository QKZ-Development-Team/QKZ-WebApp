@{
    ViewData["Title"] = "Grade C Training";
}

<section class="course-detail-page">

    <div class="course-detail-header">

        <p class="section-label">GRADE C TRAINING</p>

        <h1>Grade C Security Training</h1>

        <p>
            Explore the Grade C security training programme offered
            by QKZ Training Center.
        </p>

    </div>

    <div class="course-detail-content">

        <div class="course-info-card">

            <h2>Grade C Training</h2>

            <p>
                QKZ Training Center offers security training across
                Grades E, D, C, B and A for South African citizens.
            </p>

            <h3>Sample Study Topics</h3>

            <ul>
                <li>Security Fundamentals</li>
                <li>Access Control</li>
                <li>Communication</li>
                <li>Occupational Safety</li>
                <li>Incident Reporting</li>
                <li>Search Procedures</li>
                <li>Legal Awareness</li>
                <li>Professional Conduct</li>
            </ul>

            <p class="study-material-note">
                <strong>Note:</strong> The Grade C study material currently
                available is a sample academic demonstration and will be
                replaced with the official QKZ Training Center material
                before handover.
            </p>

        </div>

        <div class="course-action-card">

            <h2>Interested in this course?</h2>

            <p>
                Submit your registration details to enquire about
                Grade C security training.
            </p>

            <a asp-controller="Registration"
               asp-action="Index"
               class="btn">
                Register for Training
            </a>

            <a href="/study-materials/QKZ_Grade_C_Sample_Study_Material.pdf"
               target="_blank"
               class="btn study-material-btn">
                View Study Material
            </a>

        </div>

    </div>

    <div class="course-detail-actions">

        <a asp-controller="Courses"
           asp-action="Index"
           class="btn">
            Back to Courses
        </a>

    </div>

</section>