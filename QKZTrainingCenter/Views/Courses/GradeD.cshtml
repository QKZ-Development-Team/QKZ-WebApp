@{
    ViewData["Title"] = "Grade D Training";
}

<section class="course-detail-page">

    <div class="course-detail-header">

        <p class="section-label">GRADE D TRAINING</p>

        <h1>Access Control Officer</h1>

        <p>
            Grade D security training provided by QKZ Training Center.
        </p>

    </div>

    <div class="course-detail-content">

        <div class="course-info-card">

            <h2>Grade D – Access Control Officer</h2>

            <p>
                The Grade D training programme includes modules covering
                fire fighting, radio communication, occupational safety,
                public relations, access control, search procedures
                and legal aspects.
            </p>

            <h3>Training Modules</h3>

            <ul>
                <li>Basic Fire Fighting</li>
                <li>Radio Communication</li>
                <li>Basic Occupational Safety</li>
                <li>Public Relations</li>
                <li>Pocket Book</li>
                <li>Access Control</li>
                <li>Search Procedure and Techniques</li>
                <li>Legal Aspects</li>
            </ul>

            <p class="study-material-note">
                The Grade D training information displayed on this page
                is based on the QKZ Grade D training material.
            </p>

        </div>

        <div class="course-action-card">

            <h2>Interested in this course?</h2>

            <p>
                Submit your registration details to enquire about
                Grade D security training.
            </p>

            <a asp-controller="Registration"
               asp-action="Index"
               class="btn">
                Register for Training
            </a>

            <a href="/study-materials/GRADE%20D%20CLASS.pdf"
               target="_blank"
               class="btn study-material-btn">
                View Study Material
            </a>

        </div>

    </div>

    <div class="course-detail-actions">

        <a asp-controller="Courses"
           asp-action="Index"
           class="btn">
            Back to Courses
        </a>

    </div>

</section>