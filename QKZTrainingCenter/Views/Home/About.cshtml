@{
    ViewData["Title"] = "About Us";
}

<section class="about-page">

    <div class="about-header">
        <p class="section-label">ABOUT QKZ</p>

        <h1>QKZ Training Center</h1>

        <p>
            Professional security training for South African citizens.
        </p>
    </div>

    <div class="about-content">

        <div class="about-section">
            <h2>Who We Are</h2>

            <p>
                QKZ Training Center is a security training provider based
                in Howick, KwaZulu-Natal. The training center provides
                security training programmes for South African citizens.
            </p>

            <p>
                Training is offered across security grades E, D, C, B
                and A, with training options that include in-class and
                self-study approaches.
            </p>
        </div>

        <div class="about-section">
            <h2>Our Training</h2>

            <p>
                QKZ Training Center provides security training designed
                to support students in developing knowledge and skills
                relevant to the security environment.
            </p>

            <p>
                The QKZ digital platform makes it easier for prospective
                students to access course information and register for
                training online.
            </p>
        </div>

        <div class="about-section">
            <h2>Our Digital Platform</h2>

            <p>
                The website provides access to course information,
                online student registration and training-related
                information.
            </p>

            <p>
                Registered students can also access relevant training
                information through the platform.
            </p>
        </div>

    </div>

</section>