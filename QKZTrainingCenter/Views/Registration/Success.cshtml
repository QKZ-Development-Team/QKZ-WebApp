@{
    ViewData["Title"] = "Registration Submitted";
}

<section class="registration-success">

    <div class="success-card">

        <div class="success-icon">
            ✓
        </div>

        <p class="section-label">QKZ TRAINING CENTER</p>

        <h1>Registration Submitted</h1>

        <p class="success-message">
            Thank you for registering with QKZ Training Center.
            Your registration details have been received successfully.
        </p>

        <p class="success-note">
            QKZ Training Center will provide further information about
            your training once your registration has been processed.
        </p>

        <div class="success-actions">
            <a asp-controller="Account"
               asp-action="Login"
               class="btn">
                Login
            </a>

            <a asp-controller="Courses"
               asp-action="Index"
               class="btn btn-dark">
                Back to Courses
            </a>
        </div>

    

</section>